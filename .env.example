# Copy to .env (never commit .env). Both keys are optional.
# With no keys the system uses yfinance (if reachable) and otherwise a bundled SYNTHETIC dataset.

# Financial Modeling Prep: earnings calendar with BMO/AMC + revenue surprise,
# historical market cap, screener universe incl. delisted companies.
FMP_API_KEY=

# Massive (formerly Polygon.io): daily aggregates + split history.
MASSIVE_API_KEY=

# Optional overrides of config/settings.yaml (prefix PEAD_, nested with __), e.g.:
# PEAD_RISK__BASE_RISK_PER_TRADE=0.05
# PEAD_DATA__PROVIDER=auto
